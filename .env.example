# Model used by scripts/run_swebench.py; --model takes precedence.
# For an OpenAI-compatible endpoint, use the openai/ provider prefix.
MODEL_NAME=openai/your-model
MODEL_BASE_URL=https://your-model-endpoint.example/v1
MODEL_API_KEY=replace-with-your-api-key

# Streamed chunks are assembled before mini processes the response.
MODEL_STREAMING=false

# Optional native mini setting; takes precedence over MODEL_NAME.
# MSWEA_MODEL_NAME=openai/your-model
